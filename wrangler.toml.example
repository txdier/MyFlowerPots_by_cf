name = "my-flower-pots-api"
main = "src/index.ts"
compatibility_date = "2025-01-01"
keep_vars = true

# Recommended production mode:
# - manage vars in Cloudflare Dashboard / Wrangler secrets
# - keep local development values in `.dev.vars`
# - omit `[vars]` here so deploys do not overwrite dashboard vars

[dev]
port = 8787
ip = "127.0.0.1"
local_protocol = "http"

[assets]
directory = "./frontend"
binding = "ASSETS"
run_worker_first = true

[[d1_databases]]
binding = "DB"
database_name = "my-flower-pots"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"
migrations_table = "d1_migrations"

[[r2_buckets]]
binding = "STATIC_BUCKET"
bucket_name = "YOUR_R2_BUCKET_NAME"
