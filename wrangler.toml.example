name = "my-flower-pots-api"
main = "src/index.ts"
compatibility_date = "2025-01-01"
keep_vars = true

# Production vars are managed in the Cloudflare dashboard / secrets.
# `keep_vars = true` prevents `wrangler deploy` from overwriting them
# when this local-only file does not declare a `[vars]` block.

# 开发环境静态资源目录
[dev]
port = 8787
ip = "127.0.0.1"
local_protocol = "http"

# 启用静态资源及其在 Worker 中的绑定 (ASSETS)
[assets]
directory = "./frontend"
binding = "ASSETS"
run_worker_first = true

[[d1_databases]]
binding = "DB"
database_name = "my-flower-pots"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"
migrations_table = "d1_migrations"

[[r2_buckets]]
binding = "STATIC_BUCKET"
bucket_name = "my-flower-pots"

[observability]
enabled = false
head_sampling_rate = 1

[observability.logs]
enabled = true
head_sampling_rate = 1
persist = true
invocation_logs = true

[observability.traces]
enabled = true
persist = true
head_sampling_rate = 1

[placement]
mode = "smart"
