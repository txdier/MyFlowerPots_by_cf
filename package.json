{
  "name": "my-flower-pots",
  "version": "1.0.0",
  "description": "My Flower Pots - 花盆管理应用",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "npm run check:frontend && npm run check:routes && npm run check:types && npm run build-css && git diff --check && npm run check:worker",
    "check:changed": "node scripts/check-changed.js",
    "check:routes": "node scripts/check-static-routes.js",
    "check:types": "node scripts/check-types.js",
    "check:frontend": "node scripts/check-frontend.js",
    "check:worker": "node scripts/check-worker.js",
    "verify": "npm run check && npm run test:smoke",
    "verify:full": "npm run check && npm run test && npm run test:smoke && npm run test:api",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "build-css": "npx tailwindcss -i ./frontend/css/tailwind-input.css -o ./frontend/css/tailwind-built.css --config tailwind.config.cjs --minify",
    "watch-css": "npx tailwindcss -i ./frontend/css/tailwind-input.css -o ./frontend/css/tailwind-built.css --config tailwind.config.cjs --watch",
    "deploy": "npm run build-css && wrangler deploy",
    "backup-db": "node scripts/backup-d1.js",
    "plants:generate-sql": "node scripts/generate-plants-sql.js",
    "plants:migrate-local": "node scripts/migrate-plants-to-d1.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "postal-mime": "^2.7.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.0",
    "@cloudflare/workers-types": "^4.20250213.0",
    "@tailwindcss/cli": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "flower-pots",
    "plants",
    "cloudflare",
    "workers",
    "d1",
    "r2"
  ],
  "author": "My Flower Pots Team",
  "license": "MIT"
}
